# Usernames for heatmaps
GITHUB_USERNAME=your_github_username
LEETCODE_USERNAME=your_leetcode_username

# Social links shown under your name
LINKEDIN_URL=https://www.linkedin.com/in/your-linkedin-id
PERSONAL_GITHUB_URL=https://github.com/your_github_username
PERSONAL_LEETCODE_URL=https://leetcode.com/your_leetcode_username/
CONTACT_EMAIL=you@example.com

# GitHub API token (required for GitHub heatmap)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here
